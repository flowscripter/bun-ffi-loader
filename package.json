{
  "name": "@flowscripter/bun-ffi-loader",
  "version": "0.0.0",
  "description": "Resolve, download and load native libraries via Bun FFI",
  "keywords": [
    "bun",
    "dlopen",
    "ffi",
    "library",
    "native"
  ],
  "homepage": "https://github.com/flowscripter/bun-ffi-loader#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/bun-ffi-loader.git"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
